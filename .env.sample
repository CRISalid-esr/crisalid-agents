#LLM_API_BASE=https://api.openai.com/v1
LLM_API_BASE=https://llm.ilaas.fr/v1

# ILAAS
#MODEL=mistral-small-3.2-24b
#MODEL=qwen-3.6-35b-instruct
#MODEL=mistral-medium-250523
#MODEL=gpt-oss-120b
#MODEL=llama-3.3-70b
#MODEL=gemma-4-31b

# OpenAI
#MODEL=gpt-4o-mini
MODEL=gpt-5-mini

API_KEY=<your-api-key>

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-password>

# MCP Toolbox + crisalid-taxi, for SorboBotAgent
MCP_TOOLBOX_URL=http://localhost:5000
# sorbobot uses both the "sorbobot" and "crisalid-unrestricted" toolsets,
# while the "crisalid-unrestricted" toolset is used for other agents
MCP_TOOLBOX_TOOLSET=crisalid-unrestricted
SORBOBOT_TOOLSET=sorbobot
CRISALID_TAXI_URL=http://localhost:8000

# Keycloak parameters, for local authenticated deployment of crisalid-ai-skills
KEYCLOAK_ISSUER="https://keycloak.local:8443/realms/crisalid-inst"
KEYCLOAK_CLIENT_ID=example-mcp-client
KEYCLOAK_CLIENT_SECRET=********************************
KEYCLOAK_SSL_VERIFY=false

# Chat API inbound auth (same scheme as crisalid-apollo); set to "false" to disable
ENABLE_API_KEYS="true"
API_KEYS="key1,another_key"

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_URL="http://localhost:8080"
EMBEDDING_API_KEY=""
EMBEDDING_API_MODEL="your-model-name"
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_LOCAL_MODEL=""
EMBEDDING_DEVICE=cpu

